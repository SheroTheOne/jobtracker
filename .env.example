# Lokal dev (SQLite). För Postgres: postgresql://user:pass@host:5432/jobtracker
DATABASE_URL="file:./dev.db"

# AI: "mock" (gratis testläge, inga anrop) eller "google" (Gemini)
AI_PROVIDER="mock"
# Valfritt – standard är gemini-3.5-flash
# AI_MODEL="gemini-3.5-flash"
# Nyckel från https://aistudio.google.com/apikey (gratisnivå finns)
GOOGLE_GENERATIVE_AI_API_KEY=""
